{
  "functions": {
    "api/export.js": {
      "includeFiles": "templates/**"
    },
    "api/export-pptx.js": {
      "includeFiles": "templates/**"
    },
    "api/audit-export.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "assets/{NotoSans-Regular.ttf,NotoSans-Bold.ttf,NotoSansSC-Report-Regular.ttf}"
    },
    "api/audit-portfolio-export.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "redirects": [
    { "source": "/lib/:path*", "destination": "/api/__internal_file_not_found", "permanent": false },
    { "source": "/tests/:path*", "destination": "/api/__internal_file_not_found", "permanent": false },
    { "source": "/assets/:path*", "destination": "/api/__internal_file_not_found", "permanent": false }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://qhubio.com" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    }
  ]
}
